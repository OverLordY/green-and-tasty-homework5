{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "EPAM Marathon workshop 5 Owner pre-order API. Dedicated eu-north-1 development stack; signed Cognito identity, bounded DynamoDB aggregate, no public database.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "CodeBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    }
  },
  "Resources": {
    "Groups": {
      "Type": "AWS::DynamoDB::Table",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Stores groups, order state and exact-key lookups atomically.",
          "must": "Retain data; optimistic version conditions; eu-north-1 only."
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "EPAM-Marathon5"
          }
        ]
      }
    },
    "Users": {
      "Type": "AWS::Cognito::UserPool",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated development identities for real JWT ownership checks.",
          "must": "Admin-created synthetic users; no self sign-up or email sends in workshop5; optional MFA is a development exception."
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${AWS::StackName}-users"
        },
        "UserPoolTier": "LITE",
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 16,
            "RequireUppercase": true,
            "RequireLowercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "admin_only",
              "Priority": 1
            }
          ]
        },
        "UserPoolTags": {
          "Project": "EPAM-Marathon5"
        }
      }
    },
    "Client": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Public app client compatible with the supplied frontend ID-token contract.",
          "must": "No client secret; admin password flow only for local synthetic-user tests."
        }
      },
      "Properties": {
        "UserPoolId": {
          "Ref": "Users"
        },
        "ClientName": "owner-workshop",
        "GenerateSecret": false,
        "ExplicitAuthFlows": [
          "ALLOW_USER_SRP_AUTH",
          "ALLOW_ADMIN_USER_PASSWORD_AUTH"
        ],
        "EnableTokenRevocation": true,
        "PreventUserExistenceErrors": "ENABLED",
        "IdTokenValidity": 15,
        "AccessTokenValidity": 15,
        "RefreshTokenValidity": 1,
        "TokenValidityUnits": {
          "IdToken": "minutes",
          "AccessToken": "minutes",
          "RefreshToken": "days"
        }
      }
    },
    "LambdaLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Bounded retention of API execution logs.",
          "must": "Do not log tokens, passwords or request payloads."
        }
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 7
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "API Gateway request status and timing only.",
          "must": "No authorization headers or request bodies."
        }
      },
      "Properties": {
        "RetentionInDays": 7
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Runtime can read/write only its aggregate table and log group.",
          "must": "No administrative policies or wildcard data access."
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OwnerApiStorageAndLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Groups",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-api:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "ASP.NET minimal API hosted on on-demand Lambda.",
          "must": "Production auth and DynamoDB required; no in-memory fallback; compatible ARM64 ZIP."
        }
      },
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "dotnet8",
        "Architectures": [
          "arm64"
        ],
        "Handler": "Restaurant.Api",
        "Role": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "MemorySize": 512,
        "Timeout": 15,
        "Environment": {
          "Variables": {
            "ASPNETCORE_ENVIRONMENT": "Production",
            "Authentication__Authority": {
              "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${Users}"
            },
            "Authentication__Audience": {
              "Ref": "Client"
            },
            "DynamoDb__TableName": {
              "Ref": "Groups"
            },
            "Storage__UseInMemory": "false",
            "AllowedHosts": "*",
            "Cors__AllowedOrigins__0": "http://localhost:4200",
            "Cors__AllowedOrigins__1": "http://127.0.0.1:4200"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "EPAM-Marathon5"
          }
        ]
      },
      "DependsOn": [
        "LambdaLogs"
      ]
    },
    "Api": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Low-overhead HTTP API entry point.",
          "must": "Owner routes protected by JWT; explicit localhost CORS."
        }
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-http"
        },
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": [
            "http://localhost:4200",
            "http://127.0.0.1:4200"
          ],
          "AllowMethods": [
            "GET",
            "POST",
            "DELETE",
            "OPTIONS"
          ],
          "AllowHeaders": [
            "Authorization",
            "Content-Type"
          ],
          "MaxAge": 300
        }
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Translates HTTP API v2 requests into ASP.NET requests.",
          "must": "Payload format must match LambdaEventSource.HttpApi."
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "Function",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 15000
      }
    },
    "Jwt": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Rejects unsigned/foreign/expired tokens before Lambda.",
          "must": "Application also validates JWT and checks stored OwnerSubject."
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "AuthorizerType": "JWT",
        "Name": "CognitoOwner",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "JwtConfiguration": {
          "Issuer": {
            "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${Users}"
          },
          "Audience": [
            {
              "Ref": "Client"
            }
          ]
        }
      }
    },
    "DefaultRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Protects all application owner routes by default.",
          "must": "Do not replace JWT authorization with anonymous access."
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "Jwt"
        }
      }
    },
    "HealthRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Minimal public liveness endpoint.",
          "must": "Returns status only."
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "GET /health",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "InviteRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Invitation metadata is accessible to the bearer of its random invitation token.",
          "must": "No guest carts or owner operations exposed anonymously."
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "GET /guest/invites/{token}",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "OptionsRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Allows browser CORS preflight with a JWT-protected default route.",
          "must": "No data mutation through OPTIONS."
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "OPTIONS /{proxy+}",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Automatically publishes workshop routes with conservative throttling.",
          "must": "Record status only; alerts are not a hard spending cap."
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 10,
          "ThrottlingRateLimit": 5
        },
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "ApiLogs",
              "Arn"
            ]
          },
          "Format": "{\"requestId\":\"$context.requestId\",\"status\":\"$context.status\",\"route\":\"$context.routeKey\",\"latency\":\"$context.responseLatency\"}"
        }
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Allows only this API Gateway to invoke the function.",
          "must": "Scope permission to this account and API."
        }
      },
      "Properties": {
        "FunctionName": {
          "Ref": "Function"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/*"
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        }
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Value": {
        "Fn::GetAtt": [
          "Api",
          "ApiEndpoint"
        ]
      }
    },
    "TableName": {
      "Value": {
        "Ref": "Groups"
      }
    },
    "UserPoolId": {
      "Value": {
        "Ref": "Users"
      }
    },
    "AppClientId": {
      "Value": {
        "Ref": "Client"
      }
    },
    "FunctionName": {
      "Value": {
        "Ref": "Function"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    }
  }
}
